diff --git a/crates/settings_ui/src/pages/agent_jail_capabilities.rs b/crates/settings_ui/src/pages/agent_jail_capabilities.rs
new file mode 100644
index 0000000..e45edcf
--- /dev/null
+++ b/crates/settings_ui/src/pages/agent_jail_capabilities.rs
@@ -0,0 +1,256 @@
+//! The Agent Sandbox page's Capabilities (Zeo proposal §6.64 step 2, ask 87): what this
+//! project's jail may use besides the project -- which of Zeo's MCP servers, Zeo's skills, the
+//! account's claude.ai connectors -- and a word on Claude Code plugins, which Zeo does not pass.
+//!
+//! The servers listed are the project's own context servers, as Zeo runs them, plus `zeo-lsp`.
+//! A chosen one reaches the jailed agent from Zeo's copy over MCP-over-ACP (0149), so it runs
+//! outside the jail; nothing is chosen by default, and one whose configuration carries a secret
+//! asks before it is turned on (`agent_sandbox::capabilities`).
+
+use std::path::Path;
+use std::sync::Arc;
+
+use agent_sandbox::AgentSandboxSettings;
+use agent_sandbox::capabilities::{
+    SecretSite, secret_sites_of, set_project_connectors, set_project_mcp_server, set_project_skills,
+};
+use gpui::{AnyElement, App, Entity, ScrollHandle};
+use project::context_server_store::{
+    ContextServerConfiguration, ContextServerStatus, ContextServerStore,
+};
+use settings::{Settings as _, SettingsStore};
+use ui::{SwitchField, ToggleState, prelude::*};
+
+use super::{JailPageState, reveal};
+
+/// `agent_servers::acp::zeo_lsp::ZEO_LSP_SERVER_NAME`, which this crate cannot reach.
+pub(crate) const ZEO_LSP: &str = "zeo-lsp";
+
+pub(crate) const SERVERS_NOTE: &str = "Zeo's MCP servers this project's jailed agent may use. A chosen server runs outside the jail, in Zeo, and the agent reaches it through Zeo (MCP over ACP), so its tools act with your files and network. None by default; a choice applies to the next thread.";
+pub(crate) const PLUGINS_NOTE: &str = "Zeo has no plugin store yet, so the jail gets no Claude Code plugin: the host's ~/.claude/plugins is not mapped. Zeo's skills reach it as plugins, above.";
+const NO_SERVERS: &str = "This project has no MCP servers. Add one under MCP Servers.";
+
+/// One server as the page lists it.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct ServerRow {
+    pub(crate) name: String,
+    pub(crate) note: String,
+    pub(crate) secrets: Vec<SecretSite>,
+    pub(crate) chosen: bool,
+}
+
+/// The rows for `servers` (name, configuration if Zeo resolved one, status), `zeo-lsp` when it is
+/// on, and any chosen name no longer configured, so it can still be turned off. Sorted by name.
+pub(crate) fn server_rows(
+    servers: Vec<(
+        String,
+        Option<Arc<ContextServerConfiguration>>,
+        ContextServerStatus,
+    )>,
+    chosen: &[String],
+    zeo_lsp: bool,
+) -> Vec<ServerRow> {
+    let mut rows: Vec<ServerRow> = servers
+        .into_iter()
+        .map(|(name, configuration, status)| {
+            let secrets = configuration
+                .as_deref()
+                .map(secret_sites_of)
+                .unwrap_or_default();
+            let mut note = status_note(&status).to_string();
+            if !secrets.is_empty() {
+                let places = secrets
+                    .iter()
+                    .map(SecretSite::describe)
+                    .collect::<Vec<_>>()
+                    .join(", ");
+                note = format!("{note}. Carries a secret ({places}): asks before turning on");
+            }
+            ServerRow {
+                chosen: chosen.contains(&name),
+                name,
+                note,
+                secrets,
+            }
+        })
+        .collect();
+    let listed = |rows: &[ServerRow], name: &str| rows.iter().any(|row| row.name == name);
+    if (zeo_lsp || chosen.iter().any(|name| name == ZEO_LSP)) && !listed(&rows, ZEO_LSP) {
+        rows.push(ServerRow {
+            name: ZEO_LSP.to_string(),
+            note: "The project's language servers, read-only: diagnostics, definition, references, hover, symbols".to_string(),
+            secrets: Vec::new(),
+            chosen: chosen.iter().any(|name| name == ZEO_LSP),
+        });
+    }
+    for name in chosen {
+        if !listed(&rows, name) {
+            rows.push(ServerRow {
+                name: name.clone(),
+                note: "Not configured in this project".to_string(),
+                secrets: Vec::new(),
+                chosen: true,
+            });
+        }
+    }
+    rows.sort_by(|a, b| a.name.cmp(&b.name));
+    rows
+}
+
+fn status_note(status: &ContextServerStatus) -> &'static str {
+    match status {
+        ContextServerStatus::Running => "Running",
+        ContextServerStatus::Starting => "Starting",
+        ContextServerStatus::Stopped => {
+            "Stopped: handed over as configured only if the jail can start it"
+        }
+        ContextServerStatus::Error(_) => "Failed to start",
+        ContextServerStatus::AuthRequired
+        | ContextServerStatus::ClientSecretRequired { .. }
+        | ContextServerStatus::Authenticating => "Needs authentication",
+    }
+}
+
+/// The rows of the project's servers, read from its context server store.
+fn rows_from_store(
+    store: Option<&Entity<ContextServerStore>>,
+    chosen: &[String],
+    cx: &App,
+) -> Vec<ServerRow> {
+    let servers = store
+        .map(|store| {
+            let store = store.read(cx);
+            store
+                .server_ids()
+                .iter()
+                .map(|id| {
+                    (
+                        id.0.to_string(),
+                        store.configuration_for_server(id),
+                        store
+                            .status_for_server(id)
+                            .unwrap_or(ContextServerStatus::Stopped),
+                    )
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    // A test app may run without a settings store; `agent.zeo_lsp` defaults on.
+    let zeo_lsp = cx
+        .try_global::<SettingsStore>()
+        .and_then(|store| store.merged_settings().agent.as_ref()?.zeo_lsp)
+        .unwrap_or(true);
+    server_rows(servers, chosen, zeo_lsp)
+}
+
+/// The Capabilities block of the project section.
+pub(crate) fn render_capabilities(
+    root: &Path,
+    key: Option<&str>,
+    store: Option<&Entity<ContextServerStore>>,
+    state: &Entity<JailPageState>,
+    scroll_handle: &ScrollHandle,
+    cx: &mut App,
+) -> AnyElement {
+    let sandbox = AgentSandboxSettings::get_global(cx).clone();
+    let chosen = sandbox.mcp_servers_for_key(key).to_vec();
+    let rows = rows_from_store(store, &chosen, cx);
+    let mut servers = Vec::with_capacity(rows.len());
+    for row in rows {
+        let id = format!("agent-jail-mcp-{}", row.name);
+        let switch = SwitchField::new(
+            SharedString::from(id.clone()),
+            Some(SharedString::from(row.name.clone())),
+            Some(row.note.into()),
+            row.chosen,
+            {
+                let root = root.to_path_buf();
+                let name = row.name;
+                let secrets = row.secrets;
+                move |toggle, window, cx| {
+                    let on = *toggle == ToggleState::Selected;
+                    set_project_mcp_server(&root, &name, on, &secrets, window, cx).detach();
+                }
+            },
+        )
+        .tab_index(0);
+        servers.push(reveal(state, id, scroll_handle, switch, cx));
+    }
+    let skills = SwitchField::new(
+        "agent-jail-skills",
+        Some("Skills"),
+        Some("Zeo's skills (~/.agents/skills and this project's .agents/skills) as plugins, mapped read-only. Restart the agent to apply.".into()),
+        sandbox.skills_for_key(key),
+        {
+            let root = root.to_path_buf();
+            move |toggle, _, cx| {
+                set_project_skills(&root, *toggle == ToggleState::Selected, cx).detach();
+            }
+        },
+    )
+    .tab_index(0);
+    let connectors = SwitchField::new(
+        "agent-jail-connectors",
+        Some("claude.ai Connectors"),
+        Some("The account's claude.ai connectors. They reach their vendors through anthropic.com, past the allowed hosts. Restart the agent to apply.".into()),
+        sandbox.claude_ai_connectors_for_key(key),
+        {
+            let root = root.to_path_buf();
+            move |toggle, _, cx| {
+                set_project_connectors(&root, *toggle == ToggleState::Selected, cx).detach();
+            }
+        },
+    )
+    .tab_index(0);
+    let muted = |text: &'static str| Label::new(text).size(LabelSize::Small).color(Color::Muted);
+    v_flex()
+        .gap_2()
+        .child(
+            v_flex()
+                .gap_0p5()
+                .child(Label::new("Capabilities"))
+                .child(muted(
+                    "What the jailed agent may use besides the project, chosen for this project.",
+                )),
+        )
+        .child(
+            v_flex()
+                .gap_0p5()
+                .child(Label::new("MCP Servers").size(LabelSize::Small))
+                .child(muted(SERVERS_NOTE)),
+        )
+        .when(servers.is_empty(), |this| this.child(muted(NO_SERVERS)))
+        .children(servers)
+        .child(reveal(
+            state,
+            "agent-jail-skills",
+            scroll_handle,
+            skills,
+            cx,
+        ))
+        .child(
+            v_flex()
+                .gap_0p5()
+                .child(Label::new("Claude Code Plugins").size(LabelSize::Small))
+                .child(muted(PLUGINS_NOTE)),
+        )
+        .child(reveal(
+            state,
+            "agent-jail-connectors",
+            scroll_handle,
+            connectors,
+            cx,
+        ))
+        .into_any_element()
+}
