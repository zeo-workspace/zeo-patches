+//! What a jail may use besides the project (Zeo proposal §6.64 step 2, ask 87): which of Zeo's MCP
+//! servers, whether Zeo's skills, whether the account's claude.ai connectors. Per project, in
+//! `agent_sandbox.projects[<root>]`, written only here, read by the launch (skills) and by
+//! `agent_servers`' jail filter at every `session/new` (servers).
+//!
+//! A chosen server is proxied from the copy Zeo runs, outside the jail. One Zeo cannot proxy is
+//! handed to the jail as configured, and what its configuration carries -- an API key in its
+//! environment, its arguments or its headers -- is then readable inside. So a server whose
+//! configuration looks like it carries a secret is never turned on without the operator saying
+//! yes to exactly that (operator, 2026-11-22). Which part looks like a secret is decided by name
+//! and shape, never by printing or logging a value.
+
+use std::path::{Path, PathBuf};
+
+use gpui::{App, Task, Window};
+use project::context_server_store::ContextServerConfiguration;
+use settings::{AgentSandboxProjectSettingsContent, Settings as _};
+
+use crate::confirm::{ask, refuse_non_utf8_root, save, target_project_key};
+use crate::settings::{AgentSandboxSettings, resolve_project_key};
+
+/// Cancel first: Zed's prompt preselects the first button, so a stray Enter keeps the server off.
+pub const SECRET_BUTTONS: [&str; 2] = ["Cancel", "Allow"];
+
+/// Name parts that mark a value as a credential, matched on the name upper-cased with `-` as `_`.
+/// Wider than `util::redact::should_redact`'s suffixes, since a flag (`--figma-api-key`) or a
+/// header (`Authorization`) names its secret differently from an environment variable.
+const SECRET_NAME_PARTS: [&str; 9] = [
+    "KEY",
+    "TOKEN",
+    "SECRET",
+    "PASSWORD",
+    "PASSWD",
+    "PASS",
+    "CREDENTIAL",
+    "AUTH",
+    "COOKIE",
+];
+
+/// Where a server's configuration seems to carry a secret, named for the operator; never the value.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum SecretSite {
+    Env(String),
+    Argument(String),
+    Header(String),
+    UrlParameter(String),
+    /// A key of the extension's own settings, as a dotted path.
+    ExtensionSetting(String),
+    OAuthClientSecret,
+}
+
+impl SecretSite {
+    pub fn describe(&self) -> String {
+        match self {
+            Self::Env(name) => format!("environment variable {name}"),
+            Self::Argument(flag) => format!("argument {flag}"),
+            Self::Header(name) => format!("header {name}"),
+            Self::UrlParameter(name) => format!("URL parameter {name}"),
+            Self::ExtensionSetting(path) => format!("extension setting {path}"),
+            Self::OAuthClientSecret => "OAuth client secret".to_string(),
+        }
+    }
+}
+
+/// One server's configuration, as far as secrets go: a stdio command or an http endpoint.
+pub enum ServerShape<'a> {
+    Stdio {
+        args: &'a [String],
+        env: Vec<(&'a str, &'a str)>,
+    },
+    Http {
+        url: &'a str,
+        headers: Vec<(&'a str, &'a str)>,
+    },
+}
+
+fn secret_name(name: &str) -> bool {
+    let name = name.to_ascii_uppercase().replace('-', "_");
+    SECRET_NAME_PARTS.iter().any(|part| {
+        if *part != "AUTH" {
+            return name.contains(part);
+        }
+        // AUTHORIZATION is one, AUTHOR (GIT_AUTHOR_NAME, --author) is not.
+        name.match_indices(part).any(|(at, _)| {
+            let rest = &name[at + part.len()..];
+            !rest.starts_with("OR") || rest.starts_with("ORIZATION")
+        })
+    })
+}
+
+fn credential_value(value: &str) -> bool {
+    value.starts_with("Bearer ") || value.starts_with("Basic ")
+}
+
+/// Every place `shape` seems to carry a secret: a non-empty value under a secret-looking name, a
+/// secret-looking `--flag=value` or `--flag value` argument, or a `Bearer`/`Basic` credential.
+pub fn secret_sites(shape: ServerShape<'_>) -> Vec<SecretSite> {
+    let mut sites = Vec::new();
+    match shape {
+        ServerShape::Stdio { args, mut env } => {
+            env.sort();
+            sites.extend(
+                env.into_iter()
+                    .filter(|(name, value)| !value.is_empty() && secret_name(name))
+                    .map(|(name, _)| SecretSite::Env(name.to_string())),
+            );
+            for (index, arg) in args.iter().enumerate() {
+                let flag = arg.trim_start_matches('-');
+                if flag.len() == arg.len() {
+                    if credential_value(arg) {
+                        sites.push(SecretSite::Argument(format!("#{}", index + 1)));
+                    }
+                    continue;
+                }
+                let (name, inline) = match flag.split_once('=') {
+                    Some((name, value)) => (name, Some(value)),
+                    None => (flag, None),
+                };
+                let has_value = match inline {
+                    Some(value) => !value.is_empty(),
+                    None => args
+                        .get(index + 1)
+                        .is_some_and(|next| !next.starts_with('-')),
+                };
+                if has_value && secret_name(name) {
+                    let dashes = &arg[..arg.len() - flag.len()];
+                    sites.push(SecretSite::Argument(format!("{dashes}{name}")));
+                }
+            }
+        }
+        ServerShape::Http { url, mut headers } => {
+            headers.sort();
+            sites.extend(
+                headers
+                    .into_iter()
+                    .filter(|(name, value)| {
+                        !value.is_empty() && (secret_name(name) || credential_value(value))
+                    })
+                    .map(|(name, _)| SecretSite::Header(name.to_string())),
+            );
+            if let Ok(url) = url::Url::parse(url) {
+                sites.extend(
+                    url.query_pairs()
+                        .filter(|(name, value)| !value.is_empty() && secret_name(name))
+                        .map(|(name, _)| SecretSite::UrlParameter(name.into_owned())),
+                );
+            }
+        }
+    }
+    sites
+}
+
+/// [`secret_sites`] of a context server as Zeo resolved it, plus an extension's own settings
+/// (the figma extension keeps its API key there and passes it as an argument) and an OAuth client
+/// secret.
+pub fn secret_sites_of(configuration: &ContextServerConfiguration) -> Vec<SecretSite> {
+    match configuration {
+        ContextServerConfiguration::Custom { command, .. }
+        | ContextServerConfiguration::Extension { command, .. } => {
+            let env = command
+                .env
+                .iter()
+                .flatten()
+                .map(|(name, value)| (name.as_str(), value.as_str()))
+                .collect();
+            let mut sites = secret_sites(ServerShape::Stdio {
+                args: &command.args,
+                env,
+            });
+            if let ContextServerConfiguration::Extension { settings, .. } = configuration {
+                setting_sites(settings, "", &mut sites);
+            }
+            sites
+        }
+        ContextServerConfiguration::Http {
+            url,
+            headers,
+            oauth,
+            ..
+        } => {
+            let headers = headers
+                .iter()
+                .map(|(name, value)| (name.as_str(), value.as_str()))
+                .collect();
+            let mut sites = secret_sites(ServerShape::Http {
+                url: url.as_str(),
+                headers,
+            });
+            if oauth
+                .as_ref()
+                .is_some_and(|oauth| oauth.client_secret.is_some())
+            {
+                sites.push(SecretSite::OAuthClientSecret);
+            }
+            sites
+        }
+    }
+}
+
+fn setting_sites(value: &serde_json::Value, path: &str, sites: &mut Vec<SecretSite>) {
+    let serde_json::Value::Object(map) = value else {
+        return;
+    };
+    for (key, value) in map {
+        let here = if path.is_empty() {
+            key.clone()
+        } else {
+            format!("{path}.{key}")
+        };
+        match value {
+            serde_json::Value::String(text) if !text.is_empty() && secret_name(key) => {
+                sites.push(SecretSite::ExtensionSetting(here))
+            }
+            serde_json::Value::Object(_) => setting_sites(value, &here, sites),
+            _ => {}
+        }
+    }
+}
+
+/// What the secret prompt says, in two parts: the question and its detail.
+pub fn secret_prompt(server: &str, sites: &[SecretSite]) -> (String, String) {
+    let places = sites
+        .iter()
+        .map(SecretSite::describe)
+        .collect::<Vec<_>>()
+        .join(", ");
+    (
+        format!("Allow \"{server}\" in this project's jail?"),
+        format!(
+            "Its configuration carries a secret ({places}). The secret will be readable inside \
+             the jail whenever Zeo hands the server over instead of proxying it, and the agent \
+             can use the server's access either way."
+        ),
+    )
+}
+
+/// Adds `server` to the project's chosen MCP servers, or takes it out. Turning on a server that
+/// carries a secret asks first ([`secret_prompt`]); turning one off never asks. Resolves to `true`
+/// only when the file was saved.
+pub fn set_project_mcp_server(
+    root: &Path,
+    server: &str,
+    on: bool,
+    secrets: &[SecretSite],
+    window: &mut Window,
+    cx: &mut App,
+) -> Task<bool> {
+    let consent = if on && !secrets.is_empty() {
+        let (message, detail) = secret_prompt(server, secrets);
+        ask(&message, &detail, &SECRET_BUTTONS, window, cx)
+    } else {
+        Task::ready(true)
+    };
+    let root = root.to_path_buf();
+    let server = server.to_string();
+    cx.spawn(async move |cx| {
+        if !consent.await {
+            return false;
+        }
+        let write = cx.update(|cx| {
+            write_project(
+                &root,
+                "mcp_servers",
+                move |entry| {
+                    let list = entry.mcp_servers.get_or_insert_default();
+                    list.retain(|name| *name != server);
+                    if on {
+                        list.push(server);
+                        list.sort();
+                    }
+                },
+                cx,
+            )
+        });
+        write.await
+    })
+}
+
+/// Sets the project's `skills` (Zeo's skills in its jail); a restart applies it.
+pub fn set_project_skills(root: &Path, on: bool, cx: &mut App) -> Task<bool> {
+    write_project(root, "skills", move |entry| entry.skills = Some(on), cx)
+}
+
+/// Sets the project's `claude_ai_connectors`; a restart applies it.
+pub fn set_project_connectors(root: &Path, on: bool, cx: &mut App) -> Task<bool> {
+    write_project(
+        root,
+        "claude_ai_connectors",
+        move |entry| entry.claude_ai_connectors = Some(on),
+        cx,
+    )
+}
+
+/// Writes the project's entry through `update`, keyed as every other writer of `projects` keys
+/// it ([`target_project_key`]). A root that is not UTF-8 is refused and said so.
+fn write_project(
+    root: &Path,
+    field: &'static str,
+    update: impl 'static + Send + FnOnce(&mut AgentSandboxProjectSettingsContent),
+    cx: &mut App,
+) -> Task<bool> {
+    let Some(root_text) = root.to_str().map(str::to_string) else {
+        refuse_non_utf8_root(root, cx);
+        return Task::ready(false);
+    };
+    let root = root.to_path_buf();
+    cx.spawn(async move |cx| {
+        let keys: Vec<String> = cx.update(|cx| {
+            AgentSandboxSettings::get_global(cx)
+                .projects
+                .keys()
+                .cloned()
+                .collect()
+        });
+        // Canonicalizing every key blocks, so it runs off the main thread.
+        let resolved: Option<PathBuf> = cx
+            .background_executor()
+            .spawn(async move {
+                resolve_project_key(keys.iter().map(String::as_str), &root).map(PathBuf::from)
+            })
+            .await;
+        let fallback = format!("agent_sandbox.projects[{root_text}].{field}");
+        save(
+            cx,
+            move |content| {
+                let projects = content
+                    .agent_sandbox
+                    .get_or_insert_default()
+                    .projects
+                    .get_or_insert_default();
+                let key = target_project_key(projects.keys(), &root_text, resolved.as_deref());
+                let label = format!("agent_sandbox.projects[{key}].{field}");
+                update(projects.entry(key).or_default());
+                label
+            },
+            fallback,
+        )
+        .await
+    })
+}
+
