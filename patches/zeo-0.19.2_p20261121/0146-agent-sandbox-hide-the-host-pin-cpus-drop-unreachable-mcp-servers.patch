@@ -0,0 +1,77 @@
+//! Zeo proposal §6.64 step 1: a jailed agent is not handed an MCP server it cannot start.
+//!
+//! Zeo sends every enabled context server in `session/new`, and the agent starts each stdio one
+//! itself -- inside the jail, where only the system folders, the project and the writable folders
+//! are at their host paths. A server whose command or script lives elsewhere (an extension's
+//! `node .../extensions/work/<ext>/.../bin.js`) failed there with "failed to start … Run /mcp",
+//! the cause buried in the jail's MCP log (2026-11-22, `mcp-server-figma`). Such a server is now
+//! left out, one notice in the thread names it and the path that hides it, and one log line
+//! records it. Leaving it out also keeps its arguments -- the figma extension passes its API key
+//! as one -- out of the jail.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use acp_thread::AcpThread;
+use agent_client_protocol::v2::schema as acp_v2;
+use agent_sandbox::host_view::{hidden_server_path, jail_roots};
+use agent_sandbox::launch::{LaunchId, LaunchRegistry};
+use gpui::{App, Entity};
+use project::context_server_store::ContextServerConfiguration;
+
+/// The host folders the jail of `launch` shows; `None` when the launch is not jailed.
+pub(crate) fn roots(launch: Option<LaunchId>, cx: &App) -> Option<Vec<PathBuf>> {
+    let record = LaunchRegistry::launch(launch?, cx)?;
+    jail_roots(&record)
+}
+
+/// `configurations` without the stdio servers the jail cannot start, and those servers' names
+/// with the path that hides each. Without `roots` (not jailed) nothing is left out.
+pub(crate) fn split_hidden(
+    configurations: Vec<(String, Arc<ContextServerConfiguration>)>,
+    roots: Option<&[PathBuf]>,
+) -> (
+    Vec<(String, Arc<ContextServerConfiguration>)>,
+    Vec<(String, PathBuf)>,
+) {
+    let Some(roots) = roots else {
+        return (configurations, Vec::new());
+    };
+    let mut kept = Vec::with_capacity(configurations.len());
+    let mut hidden = Vec::new();
+    for (name, configuration) in configurations {
+        let path = configuration
+            .command()
+            .and_then(|command| hidden_server_path(&command.path, &command.args, roots))
+            .map(PathBuf::from);
+        match path {
+            Some(path) => hidden.push((name, path)),
+            None => kept.push((name, configuration)),
+        }
+    }
+    (kept, hidden)
+}
+
+/// One warning notice per server left out, on the thread the session opened.
+pub(crate) fn push_notices(thread: &Entity<AcpThread>, hidden: &[(String, PathBuf)], cx: &mut App) {
+    for (name, path) in hidden {
+        log::warn!(
+            "agent_sandbox event=mcp_server_left_out server={} reason=outside_jail",
+            crate::custom::log_token(name)
+        );
+        let notice = acp_v2::Notice::new(
+            acp_v2::NoticeSeverity::Warning,
+            format!("MCP server \"{name}\" is not available in the sandbox"),
+        )
+        .description(format!(
+            "It needs {}, which is outside the jail, so the agent was not given it. Turn the \
+             sandbox off for this project to use it.",
+            path.display()
+        ));
+        thread.update(cx, |thread, cx| thread.push_notice(notice, cx));
+    }
+}
+
