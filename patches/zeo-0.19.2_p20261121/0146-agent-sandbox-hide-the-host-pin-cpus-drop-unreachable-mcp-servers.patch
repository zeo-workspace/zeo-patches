@@ -0,0 +1,161 @@
+// Zeo proposal §6.63 steps 1 and 3, §6.64: what a jailed start passes ai-jail to hide the host,
+// pin the CPUs and keep the claude.ai connectors out. Filter: `host_view_launch`.
+
+use std::path::Path;
+
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use crate::host_view::{
+    CONNECTORS_ENV, HOST_MASKS, MACHINE_ID, MASK_HOST_OPTION, allowed_cpus, cpu_list,
+};
+use crate::launch_tests::*;
+
+/// The fork's 3.5.0-r1 options, plus `--cpus`; `mask_host` adds `--mask-host`.
+fn help(mask_host: bool) -> String {
+    let mask_host = if mask_host {
+        "    --mask-host  Synthetic host view\\n"
+    } else {
+        ""
+    };
+    format!(
+        "case \"$1\" in --help) printf '    --memory <SIZE>  Cap memory\\n    --state-root <DIR>  State on disk\\n    --cpus <LIST>  Pin CPUs\\n{mask_host}' ;; *) echo 'ai-jail 3.5.0' ;; esac"
+    )
+}
+
+fn settings(f: &Fixture, project: Value) -> Value {
+    let mut value = sandbox(f, true, project, memory_off());
+    value["agent_sandbox"]["limits"] =
+        json!({ "memory": "8G", "cpu_quota": 400, "max_tasks": 4096 });
+    value["agent_sandbox"]["state_root"] = json!(f.base.join("state"));
+    value
+}
+
+fn before_separator(args: &[String], flag: &str, value: &str) -> bool {
+    let separator = args.iter().position(|arg| arg == "--").expect("`--`");
+    args[..separator]
+        .windows(2)
+        .any(|pair| pair[0] == flag && pair[1] == value)
+}
+
+#[gpui::test]
+async fn host_view_launch_masks_the_host_pins_cpus_and_drops_connectors(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(false));
+    set_user_settings(settings(&f, Value::Null), cx);
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+
+    for path in HOST_MASKS.iter().copied().chain([MACHINE_ID]) {
+        if Path::new(path).exists() {
+            assert!(
+                before_separator(&cmd.args, "--mask", path),
+                "{path}: {:?}",
+                cmd.args
+            );
+        } else {
+            assert_eq!(
+                count(&cmd.args, "--mask", path),
+                0,
+                "a missing {path} is left out"
+            );
+        }
+    }
+    assert!(!cmd.args.iter().any(|arg| arg == MASK_HOST_OPTION));
+    assert!(
+        before_separator(&cmd.args, "--env", CONNECTORS_ENV),
+        "the connectors' switch reaches the jail by name: {:?}",
+        cmd.args
+    );
+    match cpu_list(Some(400), &allowed_cpus()) {
+        Some(cpus) => assert!(
+            before_separator(&cmd.args, "--cpus", &cpus),
+            "{:?}",
+            cmd.args
+        ),
+        None => assert!(
+            !cmd.args.iter().any(|arg| arg == "--cpus"),
+            "{:?}",
+            cmd.args
+        ),
+    }
+}
+
+#[gpui::test]
+async fn host_view_launch_lets_a_project_keep_its_connectors(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(false));
+    set_user_settings(settings(&f, json!({ "claude_ai_connectors": true })), cx);
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert_eq!(
+        count(&cmd.args, "--env", CONNECTORS_ENV),
+        0,
+        "{:?}",
+        cmd.args
+    );
+}
+
+/// Hostile: the host view asked for and not offered refuses the start (fail closed).
+#[gpui::test]
+async fn host_view_launch_refuses_mask_host_without_the_option(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(false));
+    set_user_settings(settings(&f, json!({ "mask_host": true })), cx);
+    let project = project(&f, cx).await;
+    let text = refused(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(text.contains("--mask-host"), "says what is missing: {text}");
+}
+
+#[gpui::test]
+async fn host_view_launch_passes_mask_host_and_keeps_the_masks(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(true));
+    set_user_settings(settings(&f, json!({ "mask_host": true })), cx);
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    let separator = cmd.args.iter().position(|arg| arg == "--").expect("`--`");
+    assert!(
+        cmd.args[..separator]
+            .iter()
+            .any(|arg| arg == MASK_HOST_OPTION)
+    );
+    for path in HOST_MASKS {
+        if Path::new(path).exists() {
+            assert!(
+                before_separator(&cmd.args, "--mask", path),
+                "{path}: {:?}",
+                cmd.args
+            );
+        }
+    }
+    assert_eq!(
+        count(&cmd.args, "--mask", MACHINE_ID),
+        0,
+        "--mask-host gives the jail its own machine id: {:?}",
+        cmd.args
+    );
+}
+
+/// An ai-jail without `--cpus` gets no pin: the quota alone still caps the jail.
+#[gpui::test]
+async fn host_view_launch_pins_nothing_without_the_option(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(
+        &f.ai_jail,
+        "case \"$1\" in --help) printf '    --memory <SIZE>  Cap memory\\n    --state-root <DIR>  State on disk\\n' ;; *) echo 'ai-jail 3.5.0' ;; esac",
+    );
+    set_user_settings(settings(&f, Value::Null), cx);
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(
+        !cmd.args.iter().any(|arg| arg == "--cpus"),
+        "{:?}",
+        cmd.args
+    );
+}
diff --git a/crates/agent_sandbox/src/host_view_tests.rs b/crates/agent_sandbox/src/host_view_tests.rs
new file mode 100644
index 0000000..a75170d
--- /dev/null
+++ b/crates/agent_sandbox/src/host_view_tests.rs
@@ -0,0 +1,145 @@
+// Zeo proposal §6.63 steps 1 and 3, §6.64 step 1: what a jail shows of the host. Filter:
+// `host_view`.
+
+use std::path::{Path, PathBuf};
+
+use super::*;
+
+fn all_exist(_: &Path) -> bool {
+    true
+}
+
+#[test]
+fn host_view_masks_the_machines_names_in_every_jail() {
+    let args = host_args(false, all_exist);
+    for path in [
+        "/etc/hostname",
+        "/etc/machine-id",
+        "/etc/fstab",
+        "/proc/cmdline",
+        "/proc/uptime",
+        "/sys/class/net",
+        "/sys/class/dmi",
+        "/sys/devices/virtual/dmi",
+    ] {
+        assert!(
+            args.windows(2)
+                .any(|pair| pair[0] == "--mask" && pair[1] == path),
+            "{path} is not masked: {args:?}"
+        );
+    }
+    assert!(!args.iter().any(|arg| arg == MASK_HOST_OPTION));
+}
+
+/// Under `mask_host` ai-jail gives the jail its own machine id, which an empty mask would hide;
+/// every other mask stays, since `--mask-host` covers none of them.
+#[test]
+fn host_view_mask_host_keeps_the_masks_and_its_own_machine_id() {
+    let masked = host_args(true, all_exist);
+    assert_eq!(masked.last().map(String::as_str), Some(MASK_HOST_OPTION));
+    assert!(!masked.contains(&MACHINE_ID.to_string()), "{masked:?}");
+    for path in HOST_MASKS {
+        assert!(masked.contains(&path.to_string()), "{path}: {masked:?}");
+    }
+}
+
+#[test]
+fn host_view_skips_a_path_this_machine_lacks() {
+    let args = host_args(false, |path| path != Path::new("/etc/fstab"));
+    assert!(!args.contains(&"/etc/fstab".to_string()), "{args:?}");
+    assert!(args.contains(&"/etc/hostname".to_string()));
+}
+
+#[test]
+fn host_view_pins_the_last_cpus_a_quota_pays_for() {
+    let host: Vec<u32> = (0..32).collect();
+    assert_eq!(cpu_list(Some(400), &host).as_deref(), Some("28-31"));
+    assert_eq!(
+        cpu_list(Some(150), &host).as_deref(),
+        Some("30-31"),
+        "rounded up"
+    );
+    assert_eq!(cpu_list(Some(100), &host).as_deref(), Some("31"));
+    assert_eq!(
+        cpu_list(Some(200), &[0, 2, 4, 6]).as_deref(),
+        Some("4,6"),
+        "only CPUs Zeo may use"
+    );
+}
+
+#[test]
+fn host_view_pins_nothing_without_a_quota_or_past_every_cpu() {
+    let host: Vec<u32> = (0..8).collect();
+    assert_eq!(cpu_list(None, &host), None);
+    assert_eq!(cpu_list(Some(0), &host), None, "0 turns the quota off");
+    assert_eq!(cpu_list(Some(800), &host), None, "all of them is no pin");
+    assert_eq!(cpu_list(Some(400), &[]), None, "unknown CPUs: no pin");
+}
+
+#[test]
+fn host_view_reads_the_kernels_cpu_lists() {
+    assert_eq!(parse_cpu_list("0-3,8,10-11\n"), vec![0, 1, 2, 3, 8, 10, 11]);
+    assert_eq!(parse_cpu_list("5"), vec![5]);
+    assert_eq!(
+        parse_cpu_list("x,2"),
+        vec![2],
+        "an unreadable part is skipped"
+    );
+}
+
+fn roots() -> Vec<PathBuf> {
+    visible_roots([
+        PathBuf::from("/w/app"),
+        PathBuf::from("/var/tmp/zeo-jail/app-1"),
+    ])
+}
+
+/// The figma case of 2026-11-22: `node` is visible, its script under Zeo's extensions is not.
+#[test]
+fn host_view_finds_a_server_whose_script_the_jail_cannot_see() {
+    let args = vec![
+        "/home/u/.local/share/zeo/extensions/work/mcp-server-figma/node_modules/figma-developer-mcp/dist/bin.js".to_string(),
+        "--figma-api-key".to_string(),
+        "SECRET".to_string(),
+        "--stdio".to_string(),
+    ];
+    let hidden = hidden_server_path(Path::new("/usr/bin/node"), &args, &roots());
+    assert_eq!(hidden, Some(Path::new(args[0].as_str())));
+}
+
+#[test]
+fn host_view_keeps_a_server_whose_files_are_inside() {
+    let args = vec![
+        "/w/app/tools/server.js".to_string(),
+        "--root=/w/app".to_string(),
+    ];
+    assert_eq!(
+        hidden_server_path(Path::new("/usr/bin/node"), &args, &roots()),
+        None
+    );
+    assert_eq!(
+        hidden_server_path(Path::new("/opt/bin/bun"), &[], &roots()),
+        None
+    );
+}
+
+#[test]
+fn host_view_finds_a_hidden_command_and_a_hidden_flag_value() {
+    let home_bin = Path::new("/home/u/.cargo/bin/server");
+    assert_eq!(hidden_server_path(home_bin, &[], &roots()), Some(home_bin));
+    let args = vec!["--config=/home/u/.config/server.toml".to_string()];
+    assert_eq!(
+        hidden_server_path(Path::new("/usr/bin/server"), &args, &roots()),
+        Some(Path::new("/home/u/.config/server.toml"))
+    );
+}
+
+/// Hostile: a parent component never counts as inside the folder it starts with, and a sibling
+/// that shares a prefix is not inside either.
+#[test]
+fn host_view_is_not_fooled_by_dot_dot_or_a_shared_prefix() {
+    let args = vec!["/usr/../home/u/x.js".to_string()];
+    assert!(hidden_server_path(Path::new("/usr/bin/node"), &args, &roots()).is_some());
+    let args = vec!["/w/app2/x.js".to_string()];
+    assert!(hidden_server_path(Path::new("/usr/bin/node"), &args, &roots()).is_some());
+}
